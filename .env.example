# Copy to .env and adjust. Read by docker compose and by the backend (pydantic-settings).
# These are local development placeholders, not real secrets.

POSTGRES_USER=mystocks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mystocks
# Host/port the backend uses to reach Postgres when run outside Docker.
# (docker compose overrides the host to the `postgres` service.)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host ports published by docker compose.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Auth. Generate a real key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Keep true. Browsers accept Secure cookies on http://localhost, so this works in local dev too.
COOKIE_SECURE=true
