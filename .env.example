# Copy to .env and adjust. Read by docker compose and by the backend (pydantic-settings).
# These are local development placeholders, not real secrets.

POSTGRES_USER=mystocks
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mystocks
# Host/port the backend uses to reach Postgres when run outside Docker.
# (docker compose overrides the host to the `postgres` service.)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host ports published by docker compose.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Auth. Generate a real key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-me-with-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Keep true. Browsers accept Secure cookies on http://localhost, so this works in local dev too.
COOKIE_SECURE=true

# Market data. Free Finnhub key (no credit card): https://finnhub.io/register
# Free tier covers symbol search + live quotes only; historical stock prices are a paid plan.
FINNHUB_API_KEY=your-finnhub-api-key
# Optional. CoinGecko works keyless; a free Demo key (https://www.coingecko.com/en/api) raises rate limits.
COINGECKO_DEMO_API_KEY=

# Deployment settings (see README "Deployment"). Leave these empty for local development.
# In production they live only in the Render dashboard, never in a file.
# ENVIRONMENT=production turns on fail-fast checks for the settings below.
ENVIRONMENT=development
# Neon direct connection string; when set it replaces the POSTGRES_* values above.
DATABASE_URL=
# Empty locally = open registration. In production, empty = registration disabled.
REGISTRATION_INVITE_CODE=
# Comma-separated emails that may see stock market data (Finnhub quotes, Tiingo history): the
# free stock data plans are licensed for personal use. Empty locally = everyone; in production,
# empty = nobody. Emails aren't verified, so list only addresses that are already registered.
STOCK_DATA_ALLOWED_EMAILS=
# Shared secret Vercel adds to proxied /api requests. Empty = check disabled (local dev).
ORIGIN_SECRET=
# Comma-separated origins allowed to make state-changing requests. Empty = not enforced.
ALLOWED_ORIGINS=
